+def _mangatl_merge_fragments(regions, original_img):
+    """mangatl patch: merge side-by-side vertical columns that belong to one bubble.
+
+    Conservative: both must be vertical, overlap vertically by half the shorter column, sit no further
+    apart than the narrower column's width, and have bright (bubble-white) pixels between them.
+    """
+    import functools
+    cached = [n for n, v in type(regions[0]).__dict__.items() if isinstance(v, functools.cached_property)] if regions else []
+    gray = cv2.cvtColor(original_img, cv2.COLOR_RGB2GRAY) if original_img.ndim == 3 else original_img
+    regions = list(regions)
+    merged = True
+    while merged:
+        merged = False
+        for i, a in enumerate(regions):
+            for j in range(i + 1, len(regions)):
+                b = regions[j]
+                ax1, ay1, ax2, ay2 = map(int, a.xyxy)
+                bx1, by1, bx2, by2 = map(int, b.xyxy)
+                aw, ah, bw, bh = ax2 - ax1, ay2 - ay1, bx2 - bx1, by2 - by1
+                if aw >= ah or bw >= bh:
+                    continue
+                gap = max(bx1 - ax2, ax1 - bx2)
+                overlap = min(ay2, by2) - max(ay1, by1)
+                if gap < 0 or gap > min(aw, bw) or overlap < 0.5 * min(ah, bh):
+                    continue
+                gx1, gx2 = (ax2, bx1) if ax2 <= bx1 else (bx2, ax1)
+                strip = gray[max(ay1, by1):min(ay2, by2), gx1:gx2]
+                if strip.size and strip.mean() < 200:
+                    continue
+                a.lines = np.concatenate([a.lines, b.lines])
+                for k in cached:
+                    a.__dict__.pop(k, None)
+                a.translation = f'{a.translation} {b.translation}'.strip()
+                a.font_size = max(a.font_size, b.font_size)
+                if os.environ.get('MANGATL_RENDER_DEBUG'):
+                    import sys
+                    print(f'[render-debug] merged fragment {[bx1, by1, bx2, by2]} into {[ax1, ay1, ax2, ay2]}', file=sys.stderr)
+                del regions[j]
+                merged = True
+                break
+            if merged:
+                break
+    return regions
+

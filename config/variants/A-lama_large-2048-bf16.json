{
  "translator": {
    "translator": "custom_openai",
    "target_lang": "ENG",
    "gpt_config": "config/gpt_config.yaml"
  },
  "detector": {
    "detector": "default"
  },
  "ocr": {
    "ocr": "mocr",
    "use_mocr_merge": true
  },
  "inpainter": {
    "inpainter": "lama_large",
    "inpainting_size": 2048,
    "inpainting_precision": "bf16"
  },
  "render": {
    "renderer": "manga2eng",
    "alignment": "center",
    "font_size_minimum": 10
  }
}